<!doctype html>
<html lang="en" class="theme-dark">
<head>
  {%@ "head" %}
</head>
<body class="{{ data.layout }} {{ data.page_class }} dark:text-slate-100">
<a href="#main" class="btn fixed left-4 top-4 z-50 -translate-y-24 focus:translate-y-0">Skip to content</a>

{%@ Shared::Navbar metadata: site.metadata, resource: resource %}

<main id="main" tabindex="-1" class="min-h-screen max-w-7xl mx-auto sm:px-4 lg:px-6">
  {%= yield %}
</main>

{%@ "footer", metadata: site.metadata %}
</body>
</html>
